<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.shop.mapper.ShopOrderItemMapper">
    
    <resultMap type="com.ruoyi.shop.domain.ShopOrderItem" id="ShopOrderItemResult">
        <result property="orderItemId"    column="order_item_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="productId"    column="product_id"    />
        <result property="productName"    column="product_name"    />
        <result property="productImage"    column="product_image"    />
        <result property="currentPrice"    column="current_price"    />
        <result property="quantity"    column="quantity"    />
        <result property="totalPrice"    column="total_price"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectShopOrderItemVo">
        select order_item_id, order_id, product_id, product_name, product_image, current_price, quantity, total_price, create_time, update_time from shop_order_item
    </sql>

    <select id="selectShopOrderItemList" parameterType="com.ruoyi.shop.domain.ShopOrderItem" resultMap="ShopOrderItemResult">
        <include refid="selectShopOrderItemVo"/>
        <where>  
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
        </where>
    </select>

    <select id="selectShopOrderItemListByOrderId" parameterType="Long" resultMap="ShopOrderItemResult">
        <include refid="selectShopOrderItemVo"/>
        where order_id = #{orderId}
    </select>
    
    <select id="selectShopOrderItemByOrderItemId" parameterType="Long" resultMap="ShopOrderItemResult">
        <include refid="selectShopOrderItemVo"/>
        where order_item_id = #{orderItemId}
    </select>
        
    <insert id="insertShopOrderItem" parameterType="com.ruoyi.shop.domain.ShopOrderItem" useGeneratedKeys="true" keyProperty="orderItemId">
        insert into shop_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="productImage != null">product_image,</if>
            <if test="currentPrice != null">current_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="totalPrice != null">total_price,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="productImage != null">#{productImage},</if>
            <if test="currentPrice != null">#{currentPrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="totalPrice != null">#{totalPrice},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <insert id="batchInsertShopOrderItem">
        insert into shop_order_item(order_id, product_id, product_name, product_image, current_price, quantity, total_price, create_time, update_time) values
        <foreach item="item" collection="list" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.productName}, #{item.productImage}, #{item.currentPrice}, #{item.quantity}, #{item.totalPrice}, #{item.createTime}, #{item.updateTime})
        </foreach>
    </insert>

    <update id="updateShopOrderItem" parameterType="com.ruoyi.shop.domain.ShopOrderItem">
        update shop_order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="productImage != null">product_image = #{productImage},</if>
            <if test="currentPrice != null">current_price = #{currentPrice},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="totalPrice != null">total_price = #{totalPrice},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where order_item_id = #{orderItemId}
    </update>

    <delete id="deleteShopOrderItemByOrderItemId" parameterType="Long">
        delete from shop_order_item where order_item_id = #{orderItemId}
    </delete>

    <delete id="deleteShopOrderItemByOrderItemIds" parameterType="String">
        delete from shop_order_item where order_item_id in 
        <foreach item="orderItemId" collection="array" open="(" separator="," close=")">
            #{orderItemId}
        </foreach>
    </delete>

    <delete id="deleteShopOrderItemByOrderId" parameterType="Long">
        delete from shop_order_item where order_id = #{orderId}
    </delete>
</mapper>

